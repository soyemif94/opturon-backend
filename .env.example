PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/clinicai?schema=public
WORKER_ID=worker-1
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10
DEFAULT_APPOINTMENT_DAYS_AHEAD=7
DEFAULT_HOLD_MINUTES=10

# Meta Webhook / WhatsApp Cloud API
# REQUIRED: must match verify token configured in Meta Webhooks
META_VERIFY_TOKEN=change_me_verify_token
# REQUIRED: permanent token with WhatsApp asset access
WHATSAPP_ACCESS_TOKEN=change_me_meta_access_token
# REQUIRED: PHONE_NUMBER_ID (not WABA ID, not Business ID)
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id
# REQUIRED for WABA subscription diagnostics and subscription checks
WHATSAPP_WABA_ID=
# OPTIONAL: Graph version (default v25.0)
WHATSAPP_GRAPH_VERSION=v25.0
# OPTIONAL: master switch for internal debug routes (/debug/*)
WHATSAPP_DEBUG=false
# OPTIONAL: additional kill switch for /debug/* APIs
DEBUG_API_ENABLED=false
# OPTIONAL: additional kill switch for /debug/ui/inbox
DEBUG_UI_ENABLED=false
DEBUG_INBOX_MAX_ITEMS=200
AUTO_REPLY_ENABLED=false
# PRODUCTION RECOMMENDED:
# WHATSAPP_DEBUG=false
# DEBUG_API_ENABLED=false
# DEBUG_UI_ENABLED=false
# AI_ENABLED=false
# REQUIRED only when WHATSAPP_DEBUG=true
WHATSAPP_DEBUG_KEY=
# OPTIONAL metadata
WHATSAPP_FROM_PHONE=
WHATSAPP_APP_ID=
WHATSAPP_SANDBOX_AR_NORMALIZE=false
META_APP_SECRET=
TOKENS_ENCRYPTION_KEY=
VERIFY_SIGNATURE=false
CLOUDFLARED_TUNNEL_NAME=clinicai-api

# Seed / onboarding (used by npm run db:seed)
SEED_CLINIC_NAME=Clinica Demo
SEED_PHONE_NUMBER_ID=
SEED_WABA_ID=
SEED_ACCESS_TOKEN=
SEED_STAFF_NAME=Recepcion

# OpenAI (recommended off in production unless explicitly rollout-enabled)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
AI_ALLOWED_STATES=READY,ASKED_NAME
AI_DENIED_STATES=CONFIRM_APPOINTMENT,ASKED_APPOINTMENT_DATETIME,ASKED_APPOINTMENT_TIMEWINDOW
AI_ALLOWED_JOB_TYPES=conversation_reply
AI_MAX_CALLS_PER_CONVERSATION_WINDOW=5
AI_WINDOW_MS=3600000
AI_ENABLED_CLINIC_IDS=
AI_DISABLED_CLINIC_IDS=
AI_ENABLED_CHANNEL_IDS=
AI_DISABLED_CHANNEL_IDS=

# Storage: json | sheets
STORAGE_MODE=json
JSON_DB_PATH=./data/patients.json
USERS_DB_PATH=./data/users.json

# Schedule
SCHEDULE_DB_PATH=./data/schedule.json

# Google Sheets (required if STORAGE_MODE=sheets)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
